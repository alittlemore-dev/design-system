{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/alittlemore.dev/design-system",
  "allowedNonPeerDependencies": [
    "^@codemirror/autocomplete$",
    "^@codemirror/commands$",
    "^@codemirror/lang-markdown$",
    "^@codemirror/language$",
    "^@codemirror/search$",
    "^@codemirror/state$",
    "^@codemirror/view$",
    "^@lezer/common$",
    "^@lezer/highlight$",
    "^dompurify$",
    "^marked$",
    "^prismjs$",
    "^tslib$"
  ],
  "assets": ["README.md", "LICENSE", "styles", "theme-preload.js"],
  "inlineStyleLanguage": "scss",
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
