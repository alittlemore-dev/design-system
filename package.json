{
  "name": "design-system-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "ng build @alittlemoron/design-system --configuration production",
    "test:api-surface": "node --test tools/api-surface/api-surface.test.mjs",
    "check:api-surface": "npm run test:api-surface && npm run build && node tools/api-surface/check-api-surface.mjs",
    "update:api-surface": "npm run build && node tools/api-surface/check-api-surface.mjs --update",
    "watch": "ng build @alittlemoron/design-system --configuration development --watch"
  },
  "dependencies": {
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.0",
    "@microsoft/api-extractor": "7.59.0",
    "ng-packagr": "22.1.1",
    "typescript": "6.0.3"
  }
}
