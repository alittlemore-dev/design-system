{
  "name": "design-system-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "ng build @alittlemore.dev/design-system --configuration production",
    "test": "npm run test:unit && npm run test:tools",
    "test:unit": "jest",
    "test:tools": "npm run test:api-surface && npm run test:package-content && npm run test:release && npm run test:styles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api-surface": "node --test tools/api-surface/api-surface.test.mjs",
    "test:package-content": "node --test tools/package-content/package-content.test.mjs",
    "test:release": "node --test tools/release/release.test.mjs tools/release/workflow-contract.test.mjs",
    "test:styles": "node --test tools/styles/style-contract.test.mjs tools/styles/theme-preload.test.mjs",
    "test:demo-tools": "node --test tools/demo/run-packed-demo.test.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:production && npm run typecheck:spec",
    "typecheck:production": "tsc --noEmit -p tsconfig.check.json",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "verify:api-surface:built": "node tools/api-surface/check-api-surface.mjs",
    "check:api-surface": "npm run test:api-surface && npm run build && npm run verify:api-surface:built",
    "update:api-surface": "npm run build && node tools/api-surface/check-api-surface.mjs --update",
    "verify:package-content:built": "node tools/package-content/check-package-content.mjs",
    "verify:styles:built": "node tools/styles/check-style-contract.mjs",
    "check:styles": "npm run test:styles && npm run build && npm run verify:styles:built",
    "verify:package": "npm run test:tools && npm run build && npm run verify:api-surface:built && npm run verify:package-content:built && npm run verify:styles:built",
    "pack:package": "node tools/release/pack-package.mjs",
    "check": "npm run test && npm run lint && npm run typecheck && npm run format:check && npm run build && npm run verify:api-surface:built && npm run verify:package-content:built && npm run verify:styles:built",
    "demo": "node tools/demo/run-packed-demo.mjs start",
    "check:demo": "npm run test:demo-tools && node tools/demo/run-packed-demo.mjs check",
    "install:demo-browser": "node tools/demo/run-packed-demo.mjs install-browser",
    "check:demo:browser": "npm run test:demo-tools && node tools/demo/run-packed-demo.mjs check-browser",
    "watch": "ng build @alittlemore.dev/design-system --configuration development --watch"
  },
  "dependencies": {
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "bootstrap": "5.3.8",
    "dompurify": "3.4.13",
    "marked": "18.0.9",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.0",
    "@types/jest": "30.0.0",
    "@types/prismjs": "1.26.6",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "jsdom": "30.0.1",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "sass": "1.101.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "zone.js": "0.16.2"
  }
}
