{
  "name": "design-system-demo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --configuration production --stats-json",
    "serve:ssr": "node dist/design-system-demo/server/server.mjs",
    "test:testing-entry-point": "node --test tests/testing-entry-point.test.mjs",
    "test:ssr": "node --test tests/ssr-smoke.test.mjs",
    "test:browser": "node --test tests/browser-smoke.test.mjs",
    "check": "npm run build && npm run test:testing-entry-point && npm run test:ssr",
    "check:browser": "npm run build && npm run test:testing-entry-point && npm run test:ssr && npm run test:browser"
  },
  "dependencies": {
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-server": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/ssr": "22.1.7",
    "bootstrap": "5.3.8",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "playwright": "^1.48.0",
    "typescript": "6.0.3"
  }
}
